<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandboxed, as the Mac App Store requires. Everything else is what
	     Backdrop does inside it, and nothing more. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Shows and media the operator opens, saves, drops or chooses. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- To open a show again without asking: at launch, after a crash,
	     and from Spotlight. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- A live feed cue. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- OSC from QLab, a lighting desk or a remote app. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Print Cue Sheet. -->
	<key>com.apple.security.print</key>
	<true/>
</dict>
</plist>
